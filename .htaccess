# Piano Challenges — Apache config for OVH web hosting

# 1. Always HTTPS, and pianochallenges.com without "www"
#    (the microphone and MIDI only work on a secure https page)
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://pianochallenges.com%{REQUEST_URI} [L,R=301]

# 2. File types
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType image/svg+xml .svg

# 3. Security and permissions (mic + MIDI allowed for this site only)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "microphone=(self), midi=(self), camera=(), geolocation=()"
</IfModule>

# 4. Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml text/plain application/xml
</IfModule>

# 5. Caching: the page is always checked for updates, assets are cached for a long time
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# 6. Unknown URLs go back to the app
ErrorDocument 404 /index.html
Options -Indexes

# The iOS app source is in the repo but must not be served
RedirectMatch 404 ^/app(/|$)
RedirectMatch 404 ^/\.git
RedirectMatch 404 ^/supabase(/|$)
RedirectMatch 404 ^/(src|tools)(/|$)
RedirectMatch 404 ^/CLAUDE\.md$
